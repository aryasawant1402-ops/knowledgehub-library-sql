# Copy to .env and fill in from the Aiven service page.
# .env is gitignored. Never commit the real password or CA certificate.

DB_HOST=your-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=true
# Path to the CA certificate downloaded from Aiven, or the PEM text.
DB_SSL_CA=./ca.pem

# Render sets PORT. Locally this is optional.
# PORT=3000
